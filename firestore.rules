rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Users collection
    // Each user can read/write only their own profile.
    match /users/{userId} {
      allow read, update, delete: if
        request.auth != null
        && request.auth.uid == userId;
      allow create: if
        request.auth != null
    }

    // 2. CategoryToWorker
    // Any authenticated user may read available categories.
    // Only admin (or trusted back-end function) may write or update the worker lists.
    match /CategoryToWorker/{categoryId} {
      allow read, write: if false;
    }


    // 3. SubcategoryToWorker

    match /SubcategoryToWorker/{subcategoryId} {
      allow read, write: if false;
    }

    // ---------------------------
    // 4. InitialisationStatus
    // ---------------------------
    // Readable by any auth user (so you can check if seeding is done).
    // Writes only once, by admin (or by a one-time Cloud Function).
    match /InitialisationStatus/{docId} {
      allow read: if false;

      allow create: if
     !exists(/databases/$(database)/documents/InitialisationStatus/$(docId));

      allow update, delete: if
        false;  // permanently lock it after creation
    }

    // ---------------------------
    // 5. Worker Schedules (example subcollection)
    // ---------------------------
    // Each worker sees only their own schedules.
    match /users/{workerId}/schedules/{scheduleId} {
      allow read, write: if
        request.auth != null
        && request.auth.uid == workerId;
    }

    // 6. Bookings (client-side)

    // Each client sees only their own bookings.
    match /bookings/{bookingId} {
      allow create: if request.auth != null
                && get(
                     /databases/$(database)/documents/users/$(request.auth.uid)
                   ).data.role == 'user';

      allow read: if
        request.auth != null
        && resource.data.userId == request.auth.uid;
      
      allow read, update: if
        request.auth != null
        && resource.data.workerId == request.auth.uid;
    }

    // ---------------------------
    // 7. Fallback
    // ---------------------------
    // Deny all other accesses by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}